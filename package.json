{
  "name": "nestjs-graphql-mysql-dev-ops-starter",
  "version": "1.0.0",
  "description": "Nest TypeScript starter repository",
  "license": "MIT",
  "scripts": {
    "prebuild": "npx rimraf dist",
    "build": "env NODE_ENV=development npx nest build; cp .env.development dist/.env",
    "build:test": "env NODE_ENV=test npx nest build; cp .env.test dist/.env",
    "build:production": "env NODE_ENV=production npx nest build; npm prune --production; cp -R .env dist node_modules production",
    "format": "npx prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "env NODE_ENV=development npx nest start --watch",
    "start:test": "env NODE_ENV=test nest start",
    "start:production": "env NODE_ENV=production npx nest start",
    "start:debug": "env NODE_ENV=development npx nest start --debug --watch",
    "typeorm": "env NODE_ENV=development node --require ts-node/register ./node_modules/typeorm/cli",
    "migrate:up": "npm run typeorm migration:run",
    "migrate:down": "npm run typeorm migration:revert",
    "lint": "npx eslint '{src,apps,libs,test}/**/*.ts' --fix",
    "test": "env NODE_ENV=test npx jest --runInBand --silent --detectOpenHandles",
    "test:watch": "env NODE_ENV=test npx jest --watch --runInBand --silent --detectOpenHandles",
    "test:coverage": "env NODE_ENV=test npx jest --coverage --runInBand --silent --detectOpenHandles",
    "test:debug": "env NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "cypress:start": "env NODE_ENV=test npx cypress open",
    "cypress:run": "env NODE_ENV=test npx cypress run",
    "test:integration": "env NODE_ENV=test npx start-server-and-test start:test http://localhost:3000/users cypress:run",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/apollo": "^13.1.0",
    "@graphql-tools/schema": "^10.0.25",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.1",
    "graphql": "^16.11.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.0.6",
    "js-sha512": "^0.9.0",
    "moment": "^2.30.1",
    "mysql2": "^3.14.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.26",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/js-sha512": "^0.8.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "commitizen": "^4.3.1",
    "coveralls": "^3.1.1",
    "cypress": "^14.5.4",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "prettier": "^3.6.2",
    "pretty-quick": "^4.2.2",
    "rimraf": "6.0.1",
    "start-server-and-test": "^2.0.13",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-loader": "9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "tsconfig.json",
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint/eslint-plugin"
    ],
    "extends": [
      "plugin:@typescript-eslint/eslint-recommended",
      "plugin:@typescript-eslint/recommended",
      "prettier"
    ],
    "root": true,
    "env": {
      "node": true,
      "jest": true
    },
    "overrides": [
      {
        "files": [
          "src/**/*.ts"
        ],
        "excludedFiles": "*.js"
      }
    ],
    "rules": {
      "@typescript-eslint/interface-name-prefix": "off",
      "@typescript-eslint/explicit-function-return-type": "error",
      "@typescript-eslint/no-explicit-any": "error",
      "@typescript-eslint/no-floating-promises": "error"
    }
  },
  "prettier": {
    "singleQuote": true,
    "semi": false
  },
  "jest": {
    "collectCoverage": true,
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/assets/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "tests/results",
          "outputName": "report.xml"
        }
      ],
      [
        "jest-html-reporters",
        {
          "pageTitle": "Test Report",
          "publicPath": "tests/results/report.html"
        }
      ]
    ],
    "coverageReporters": [
      "lcovonly",
      "html",
      "text"
    ],
    "coverageDirectory": "tests/coverage",
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
